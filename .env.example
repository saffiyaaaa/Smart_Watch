# Copy to .env and adjust. .env is gitignored; this file is the documented contract.
# Every value here maps 1:1 to a field on Settings in backend/app/config.py.

# ---------------------------------------------------------------- application
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
# Host port is 5433 because a local Postgres usually already owns 5432.
DATABASE_URL=postgresql+psycopg://smw:smw_dev_password@localhost:5433/smart_market_watchlist
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=5000

# ----------------------------------------------------------------------- auth
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------- provider
# yfinance | mock | failing | timeout | stale | malformed | conflicting
# Everything except yfinance is deterministic and needs no network.
MARKET_PROVIDER=mock
PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=0.5

# ------------------------------------------------------------------ freshness
# See docs/product-spec.md section 2.
FRESHNESS_FRESH_SECONDS=300
FRESHNESS_STALE_SECONDS=900
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00

# --------------------------------------------------------------------- scoring
# See docs/product-spec.md section 4. Changing these changes what users are
# shown, so they are configuration, never literals scattered in the code.
PRICE_MIN_PCT=1.0
PRICE_MAX_PCT=8.0
PRICE_MAX_POINTS=55.0
VOLUME_MIN_RATIO=1.5
VOLUME_MAX_RATIO=5.0
VOLUME_MAX_POINTS=45.0

CONFIDENCE_DELAYED=0.85
CONFIDENCE_STALE=0.60
CONFIDENCE_CONFLICTING=0.50
CONFIDENCE_NO_VOLUME_BASELINE=0.85

SEVERITY_WATCH_MIN=20
SEVERITY_IMPORTANT_MIN=50
SEVERITY_HIGH_MIN=75

VOLUME_BASELINE_SESSIONS=20
VOLUME_BASELINE_MIN_SESSIONS=5
CONFLICT_PRICE_TOLERANCE_PCT=0.5

# --------------------------------------------------------------------- worker
WORKER_INTERVAL_SECONDS=300
WORKER_SYMBOL_CONCURRENCY=4
FIRST_VISIT_LOOKBACK_HOURS=24
FIRST_VISIT_MAX_EVENTS=20
CHANGE_FEED_MAX_EVENTS=100

# -------------------------------------------------------------------- caching
# Off by default. Phase 12 concern; provisioned but unused in phases 0-11.
REDIS_URL=redis://localhost:6380/0
CACHE_ENABLED=false
CACHE_QUOTE_TTL_SECONDS=30

# ------------------------------------------------------------------- frontend
CORS_ORIGINS=http://localhost:5173
